@inherits LayoutComponentBase

@inject FolderService folderService;
@inject FileService fileService;

<div class="page" style="--icon-folder: url('./api/utilities/icon/@ItemType.Folder');--folder-item-width: 10%">

    <div class="topbar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16" @onclick="ToggleSidebar">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
        </svg>
    </div>

    <div class="sidebar @(SidebarOpen ? "open" : "")">
        <div>
            <a href="/" class="page-link" @onclick="PageChanged">Home</a>
            <hr />
            <a href="/search" class="page-link" @onclick="PageChanged">Search</a>
            <hr />
            <a href="/tags" class="page-link" @onclick="PageChanged">Tags</a>
            <hr />
            <a href="/settings" class="page-link" @onclick="PageChanged">Settings</a>
            <hr />
            <a href="/admin" class="page-link" @onclick="PageChanged">Admin</a> @* TODO - Security on Admin Page *@
        </div>
        <FileBox.Client.Components.FolderNavigation.FolderStructure />
    </div>

    <main>
        <article class="content px-4 @(SidebarOpen ? "sidebar-open" : "")">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>